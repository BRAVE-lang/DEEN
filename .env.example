# DEEN Application Environment Variables Example
# Duplicate this file to .env and fill in your genuine credentials.
# NEVER commit your actual .env file or Supabase service-role keys.

# Supabase Public Configuration (Safe for client-side)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Application Settings
VITE_APP_NAME=DEEN
VITE_APP_TAGLINE=Every day, closer to Allah.
VITE_APP_VERSION=1.0.0
